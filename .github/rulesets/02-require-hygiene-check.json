{
  "name": "crm-fe require repo-hygiene (step 2 of 2)",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/dev", "refs/heads/staging", "refs/heads/master"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [{ "context": "guard" }]
      }
    }
  ],
  "bypass_actors": []
}
