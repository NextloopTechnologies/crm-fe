# ── Backend API ───────────────────────────────────────────────────────────────
# Base URL of the CRM backend, including the API version prefix.
# Leave unset to use the relative "/api", which the Vite dev server proxies
# to the target configured in vite.config.ts (default http://localhost:8080).
VITE_API_URL=http://localhost:8080/api

# ── Avatar service ────────────────────────────────────────────────────────────
# Consumers append "&seed=<value>", so this URL must already carry a query string.
VITE_AVATAR_URL=https://api.dicebear.com/9.x/initials/svg?radius=50
