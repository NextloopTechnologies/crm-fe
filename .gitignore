# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/

# ── Environment variables — NEVER commit these ────────────────────────────────
.env.development.local
.env.test.local
.env.production.local
.env

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Cache ─────────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.vite/
.eslintcache
.stylelintcache
.prettiercache

# ── Package manager lock files (keep only one) ────────────────────────────────
# Uncomment the ones you are NOT using to avoid conflicts
# yarn.lock
# pnpm-lock.yaml
# package-lock.json   ← keep this if using npm

# ── Misc ──────────────────────────────────────────────────────────────────────
*.local
*.orig
.npmrc.local
config.bat
